# اختياري: الاستماع على واجهة محددة (الافتراضي في الكود 0.0.0.0)
# HOST=127.0.0.1

# Railway / Docker: مجلد دائم لجلسات Baileys (اربط Volume ثم استخدم مساراً مطلقاً)
# WHATSAPP_SESSIONS_PATH=/data/sessions

# مفتاح سري لحماية الواجهة. عند ضبطه يجب أن يرسل كل عميل الترويسة x-api-key (أو Authorization: Bearer).
# اتركه فارغًا ليبقى السلوك القديم (واجهة مفتوحة) حتى تحدّث كل الأنظمة التي تستخدم الخدمة.
# API_KEY=

# إعادة الاتصال تلقائيًا عند التشغيل بكل جلسة مربوطة محفوظة (يتطلب مجلد جلسات دائمًا WHATSAPP_SESSIONS_PATH)
# AUTO_RESTORE_SESSIONS=true
